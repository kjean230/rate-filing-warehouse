# Copy to .env and fill in. Never commit .env.
#
# Contact string embedded in the outgoing User-Agent on every request.
# Every HTTP request this project makes identifies itself truthfully. Use a URL
# or an email address a source operator could actually reach you at.
#
# See CLAUDE.md "Honest User-Agent, always" and docs/source-recon.md §1.
INGEST_CONTACT=https://github.com/kerwynjean/rate-filing-pipeline

# Phase 1 requires no API keys. The Anthropic key arrives at Phase 2.
# ANTHROPIC_API_KEY=
